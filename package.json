{
  "name": "my-app",
  "version": "0.0.0",
  "engines": {
    "node": ">=14.0.0 <24.0.0",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/verify-node-for-ng9.js",
    "prebuild": "node scripts/verify-node-for-ng9.js",
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider ng serve",
    "start:open": "cross-env NODE_OPTIONS=--openssl-legacy-provider ng serve --open",
    "build": "cross-env NODE_OPTIONS=\"--openssl-legacy-provider --max-old-space-size=8192\" ng build --configuration=production --aot=true --output-hashing=all",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "deploy_dev": "ng build --prod --aot=true --output-hashing=all --extract-css=true && npm run add_date",
    "deploy_prd": "ng build --prod && npm run add_date",
    "add_date": "npm run add_date_js && npm run add_date_css && npm run rm_bak_files",
    "add_date_js": "for i in dist/*; do if [ -f $i ]; then LC_ALL=C sed -i.bak 's:js\":js?'$(date +%H%M%m%d%y)'\":g' $i; fi done",
    "add_date_css": "sed -i.bak 's:css\":css?'$(date +%H%M%m%d%y)'\":g' dist/index.html",
    "rm_bak_files": "find dist -name '*.bak' -exec rm -Rf {} \\;"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "postinstall": "ngcc",
  "private": true,
